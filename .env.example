# Autonomous UI Test Harness — configuration template
#
# Setup:
#   cp .env.example .env
#   # Edit .env with your API keys and overrides
#
# .env is gitignored (secrets stay local). This file is committed as the template.

# ------------------------------------------------------------------------------
# Harness run
# ------------------------------------------------------------------------------
DEPTH_N=3
MAX_TRAJECTORIES=20
MAX_PARALLEL=4
OUTPUT_DIR=output
MAX_ACTIONS_PER_NODE=8
BFS_VERBOSE=0
# Retries per instruction when resolution/execution/outcome verification fails
EXECUTOR_INSTRUCTION_RETRIES=3

# ------------------------------------------------------------------------------
# LLM provider
# ------------------------------------------------------------------------------
# Options: anthropic | openai | local
# Leave empty to auto-detect (non-empty Anthropic key → OpenAI key → local fallback)
LLM_PROVIDER=

# Cloud API keys (fill in the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# Local OpenAI-compatible endpoint (used when LLM_PROVIDER=local or no cloud key)
# e.g. http://localhost:8000
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=Qwen/Qwen3.5-9B

# ------------------------------------------------------------------------------
# Docker / app under test
# ------------------------------------------------------------------------------
DOCKER_IMAGE=memos-buggy:latest
CONTAINER_PORT=5230
HEALTH_PATH=/healthz
HEALTH_TIMEOUT=120

# ------------------------------------------------------------------------------
# Browser (Playwright)
# ------------------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# ------------------------------------------------------------------------------
# Report server
# ------------------------------------------------------------------------------
REPORT_PORT=8765
